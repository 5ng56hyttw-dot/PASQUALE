Perfetto. **Non incollare ancora codice**: voglio evitare di farti perdere tempo con un file enorme e difficile da gestire dall'iPhone.

Facciamo una versione iniziale molto semplice e poi la ampliamo.

Nel riquadro grande di `index.html`, incolla questo:

```html
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AGENTE PRO</title>

<style>
body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Arial;
  background:#f4f6fa;
  color:#172033;
}
header{
  background:linear-gradient(135deg,#1261e8,#2639b8);
  color:white;
  padding:28px 20px;
  border-radius:0 0 25px 25px;
}
h1{margin:0;font-size:30px}
.subtitle{opacity:.85;margin-top:5px}
.container{padding:18px}
.cards{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.card{
  background:white;
  padding:18px;
  border-radius:18px;
  box-shadow:0 3px 12px #00000010;
}
.card small{color:#777}
.value{font-size:22px;font-weight:700;margin-top:7px}
button{
  border:0;
  border-radius:14px;
  padding:15px;
  font-size:16px;
  font-weight:600;
  background:#1261e8;
  color:white;
  width:100%;
  margin-top:10px;
}
input{
  width:100%;
  box-sizing:border-box;
  padding:14px;
  margin-top:8px;
  border:1px solid #ddd;
  border-radius:12px;
  font-size:16px;
}
.section{
  margin-top:25px;
}
.green{color:#16a05d}
.orange{color:#f08a00}
</style>
</head>

<body>

<header>
<h1>AGENTE PRO</h1>
<div class="subtitle">Gestionale commerciale</div>
</header>

<div class="container">

<div class="cards">

<div class="card">
<small>Fatturato</small>
<div class="value" id="fatturato">€ 0,00</div>
</div>

<div class="card">
<small>Ordini</small>
<div class="value" id="ordini">0</div>
</div>

<div class="card">
<small>Clienti</small>
<div class="value" id="clienti">0</div>
</div>

<div class="card">
<small>Provvigioni</small>
<div class="value green" id="provvigioni">€ 0,00</div>
</div>

</div>

<div class="section">

<div class="card">

<h2>Nuovo cliente</h2>

<input id="nomeCliente" placeholder="Nome / Ragione sociale">

<input id="provCliente"
placeholder="Provvigione cliente %"
type="number"
step="0.01">

<button onclick="aggiungiCliente()">
Aggiungi cliente
</button>

</div>

</div>

<div class="section">

<div class="card">

<h2>Nuovo prodotto</h2>

<input id="nomeProdotto" placeholder="Nome prodotto">

<input id="prezzoProdotto"
placeholder="Prezzo netto €"
type="number"
step="0.01">

<input id="provProdotto"
placeholder="Provvigione prodotto %"
type="number"
step="0.01">

<button onclick="aggiungiProdotto()">
Aggiungi prodotto
</button>

</div>

</div>

<div class="section">

<div class="card">

<h2>Nuovo ordine</h2>

<input id="clienteOrdine" placeholder="Cliente">

<input id="prodottoOrdine" placeholder="Prodotto">

<input id="quantita"
placeholder="Quantità"
type="number"
value="1">

<input id="prezzoOrdine"
placeholder="Prezzo netto €"
type="number"
step="0.01">

<input id="provOrdine"
placeholder="Provvigione %"
type="number"
step="0.01">

<button onclick="aggiungiOrdine()">
Salva ordine
</button>

</div>

</div>

<div class="section">

<div class="card">

<h2>Ultimo ordine</h2>

<div id="ultimoOrdine">
Nessun ordine inserito.
</div>

</div>

</div>

</div>

<script>

let clienti =
JSON.parse(localStorage.getItem("clienti") || "[]");

let prodotti =
JSON.parse(localStorage.getItem("prodotti") || "[]");

let ordini =
JSON.parse(localStorage.getItem("ordini") || "[]");


function euro(numero){

return new Intl.NumberFormat(
"it-IT",
{
style:"currency",
currency:"EUR"
}
).format(numero);

}


function salva(){

localStorage.setItem(
"clienti",
JSON.stringify(clienti)
);

localStorage.setItem(
"prodotti",
JSON.stringify(prodotti)
);

localStorage.setItem(
"ordini",
JSON.stringify(ordini)
);

aggiorna();

}


function aggiungiCliente(){

let nome =
document.getElementById("nomeCliente").value;

let prov =
parseFloat(
document.getElementById("provCliente").value
) || 0;

if(!nome){

alert("Inserisci il nome del cliente");

return;

}

clienti.push({

nome:nome,
provvigione:prov

});

document.getElementById("nomeCliente").value="";
document.getElementById("provCliente").value="";

salva();

}


function aggiungiProdotto(){

let nome =
document.getElementById("nomeProdotto").value;

let prezzo =
parseFloat(
document.getElementById("prezzoProdotto").value
) || 0;

let prov =
parseFloat(
document.getElementById("provProdotto").value
) || 0;

if(!nome){

alert("Inserisci il prodotto");

return;

}

prodotti.push({

nome:nome,
prezzo:prezzo,
provvigione:prov

});

document.getElementById("nomeProdotto").value="";
document.getElementById("prezzoProdotto").value="";
document.getElementById("provProdotto").value="";

salva();

}


function aggiungiOrdine(){

let cliente =
document.getElementById("clienteOrdine").value;

let prodotto =
document.getElementById("prodottoOrdine").value;

let quantita =
parseFloat(
document.getElementById("quantita").value
) || 1;

let prezzo =
parseFloat(
document.getElementById("prezzoOrdine").value
) || 0;

let prov =
parseFloat(
document.getElementById("provOrdine").value
) || 0;

if(!cliente || !prodotto || prezzo<=0){

alert("Compila tutti i dati dell'ordine");

return;

}

let totale =
quantita * prezzo;

let commissione =
totale * prov / 100;

ordini.push({

cliente:cliente,
prodotto:prodotto,
quantita:quantita,
totale:totale,
provvigione:commissione,
data:new Date().toLocaleDateString("it-IT")

});

document.getElementById("clienteOrdine").value="";
document.getElementById("prodottoOrdine").value="";
document.getElementById("quantita").value="1";
document.getElementById("prezzoOrdine").value="";
document.getElementById("provOrdine").value="";

salva();

}


function aggiorna(){

let fatturato =
ordini.reduce(
(t,o)=>t+o.totale,
0
);

let provvigioni =
ordini.reduce(
(t,o)=>t+o.provvigione,
0
);

document.getElementById("fatturato")
.innerText=euro(fatturato);

document.getElementById("provvigioni")
.innerText=euro(provvigioni);

document.getElementById("ordini")
.innerText=ordini.length;

document.getElementById("clienti")
.innerText=clienti.length;


if(ordini.length){

let o=ordini[ordini.length-1];

document.getElementById("ultimoOrdine")
.innerHTML=

"<b>"+o.cliente+"</b><br>"+
o.prodotto+
"<br>"+
"Totale: "+euro(o.totale)+
"<br>"+
"<span class='green'>"+
"Provvigione: "+
euro(o.provvigione)+
"</span>";

}

}


aggiorna();

</script>

</body>
</html>
```

### Adesso

Dopo aver incollato il codice:

1. Tocca **Commit changes**.
2. Torna alla pagina del repository.
3. Dimmi **“fatto”**.

Poi configuriamo **GitHub Pages** e ti faccio aprire AGENTE PRO direttamente da Safari sul tuo iPhone.
